{
  "name": "pocketbase-mcp",
  "version": "1.1.0",
  "main": "build/index.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:contract": "node scripts/smoke.mjs --contract-only"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pocketbase"
  ],
  "author": "",
  "license": "ISC",
  "description": "MCP server for interacting with a PocketBase instance (records, collections, files, logs, crons and migrations).",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pocketbase": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
